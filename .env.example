# Optional. Everything works without a .env file (defaults shown below).
# Copy to .env only if you need to change something.

# AI provider for the AI features (tailored CV generation + mock interviews):
#   openai (default) | gemini
# Leave the keys empty to run without AI; demo CV/interviews are pre-loaded anyway.
AI_PROVIDER=openai

# OpenAI (used when AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini (used when AI_PROVIDER=gemini) — key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Host ports
FRONTEND_PORT=3000
BACKEND_PORT=8080
DB_PORT=5434

# Database credentials (used by the db and backend containers)
DB_USERNAME=trayectoria
DB_PASSWORD=trayectoria

# Base64 secret, at least 32 bytes. Generate one with: openssl rand -base64 32
# (a demo default is used if you leave this unset — never reuse it in production)
# JWT_SECRET=

# Optional image uploads
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Load fictional demo data on the first start (set to false to start empty)
SEED_DEMO_DATA=true
