# .env.local — Copy this file and fill in your values. Never commit .env.local.
#
# Every NEXT_PUBLIC_* variable is baked into the bundle at BUILD time, so changing one
# means rebuilding / redeploying (restarting `npm run dev` is enough in development).
# Read in a single place: src/config/env.ts.  More detail: docs/demo-mode.md

#  Mode
# The frontend runs in ONE of two modes:
#
#   Demo mode ACTIVE (NEXT_PUBLIC_DEMO_MODE=true)
#     No backend needed and no request leaves the browser: an in-browser mock answers
#     with fictional data, a banner explains it, and /login offers one-click sample
#     accounts. Meant for portfolio deployments (e.g. Vercel). NEXT_PUBLIC_API_URL is
#     ignored — leave it unset.
#
#   Demo mode INACTIVE (default)
#     Talks to the real backend, so NEXT_PUBLIC_API_URL is required. A production
#     build (`npm run build`) without it FAILS on purpose instead of pointing at localhost.
#     `npm run dev` falls back to http://localhost:8080/api.
NEXT_PUBLIC_DEMO_MODE=false

#  API (only when the demo mode is inactive)
# Base URL of the backend, without /v1. The browser calls it directly.
NEXT_PUBLIC_API_URL=http://localhost:8080/api

#  Phase 2 (WebSocket / Voice) 
# NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws
# NEXT_PUBLIC_ENABLE_VOICE=false
