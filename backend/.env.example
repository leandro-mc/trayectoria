# ================================================================
#  TrayectorIA Backend — Environment Variables
#  Copy this file to .env and fill in your values.
# ================================================================

SPRING_PROFILES_ACTIVE=dev

PORT=8080

# Database
DB_URL=jdbc:postgresql://localhost:5434/trayectoria
DB_USERNAME=postgres
DB_PASSWORD=yourpassword

JPA_DDL_AUTO=validate
JPA_SHOW_SQL=true
JPA_FORMAT_SQL=true

FLYWAY_ENABLED=true

# JWT — generate with: openssl rand -base64 32
JWT_SECRET=replace-with-your-generated-secret
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_MS=604800000

# AI provider: openai (default) | gemini
AI_PROVIDER=openai

# OpenAI (used when AI_PROVIDER=openai)
OPENAI_API_KEY=sk-...
OPENAI_ENDPOINT=https:...

# Google Gemini (used when AI_PROVIDER=gemini)
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
